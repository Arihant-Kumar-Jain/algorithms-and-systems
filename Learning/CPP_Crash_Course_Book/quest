def side_index(book):
    lines = ["# 🗺️ Side Quests", "",
             "Optional books that sit alongside C++ Crash Course. They earn XP and count as study days for your streak,",
             "but they never block chapter clears or bosses. Pick one up when it fits what you're working on.", "",
             "| Key | Book | Quests | Labs | Reward | Pairs with |", "|---|---|---|---|---|---|"]
    for s in book.side.values():
        nq = sum(len(sc["reading"]) for sc in s["chapters"])
        nopt = sum(1 for sc in s["chapters"] for q in sc["reading"] if q["optional"])
        lines.append(f"| `{s['key']}` | [{s['title']}]({Path(s['dir']).name}/notes.md) · {s['author']} | {nq - nopt} (+{nopt} optional) "
                     f"| {len(s['labs'])} | {s['xp']} XP | {s['pairs_text']} |")
    lines += ["", "## How to play", "",
              "```bash",
              "./quest side            # all side books + progress",
              "./quest side dbg        # one book: its quests, page ranges and labs",
              "./quest read dbg        # mark the next quest in that book as read",
              "./quest done dbg-1 \"what happened\"   # claim a lab",
              "./quest pdf dbg         # open the book",
              "```", ""]
    return "\n".join(lines)


def boss_readme(book, b):
    chs = ", ".join(str(n) for n in b["unlock"])
    build = {"sanitize": "with AddressSanitizer + UBSan", "tsan": "with ThreadSanitizer",
             "plain": "", "boost": "against Boost"}[b["build"]]
    lines = [f"# 🐉 Boss {b['n']} · {b['name']}", "",
             f"> Unlocks after clearing chapters **{chs}** · Reward **{b['xp']} XP** · Fight: `./quest boss {b['n']}`",
             "", b["pitch"], "",
             "## Win conditions",
             "Tick a box (`- [x]`) only when it's genuinely done. Every tick takes a chunk off the boss's HP.", ""]
    lines += [f"- [ ] {g}" for g in b["goals"]]
    lines += ["", "## How the fight works",
              f"- `./quest boss {b['n']}` compiles every `.cpp` in this folder (except `tests/`) {build}".rstrip() + "."]
    if b["n"] == 5:
        lines += ["- Then every `tests/<name>.in` is piped into the program and the output is compared with `tests/<name>.out`."]
    elif b["build"] in ("sanitize", "tsan") and b["n"] != 7:
        arg = " ".join(b["args"])
        lines += [f"- Then it runs `./{b['dir']}{(' ' + arg) if arg else ''}`, which must exit with code 0 (your self-test)."]
    lines += ["- The boss falls when **all** boxes are ticked **and** the build (plus any tests) passes.",
              f"- Run it by hand any time: `./quest run boss{b['n']} -- <args>`", ""]
    if b["n"] == 5:
        lines += ["## Protocol (what the tests expect)",
                  "| Command | Output |", "|---|---|",
                  "| `SET k v` | `OK` |", "| `GET k` | the value, or `(nil)` |", "| `DEL k` | `1` if removed, else `0` |",
                  "| `INCR k` | the new integer value (missing keys start at 0) |", "| `COUNT` | number of keys |",
                  "| `KEYS <regex>` | matching keys, sorted, one per line |", "| `HISTORY n` | last n commands, oldest first |",
                  "| `QUIT` | exits (no output) |", "",
                  "Unknown commands print `ERR unknown command`.", ""]
    lines += ["## Battle notes", "<!-- Design decisions, what was hard, what you'd do differently. -->", ""]
    return "\n".join(lines)


