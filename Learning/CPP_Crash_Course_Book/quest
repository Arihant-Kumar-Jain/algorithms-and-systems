                                   "reading": [rq(q) for q in sc["reading"]]} for sc in s["chapters"]],
                     "labs": [ex(s, x) for x in s["labs"]]})
    nr = next_read(book, save, k)
    nxt = {"read": dict(rq(nr[1]), ch=nr[0]["num"]) if nr else None, "ex": None}
