                   "lo": k.lo, "hi": k.hi, "streak": k.streak, "best": k.best, "freezes": k.freezes,
                   "at_risk": k.at_risk, "today_xp": k.today_xp, "goal": k.goal, "minutes": k.minutes,
                   "book_frac": k.frac, "done_req": k.done_req, "total_req": k.total_req, "last14": k.last14},
