_ID_READ = re.compile(r"^(\d+\.\d+|\d+|\d+\.all|[a-z]+(\.\d+)?(\.(\d+|all))?)$")
_ID_EX = re.compile(r"^(\d+|[a-z]+)-\d+$")


def _safe_text(args):
    return all(len(a) <= 600 and not a.startswith("-") for a in args)


def world_cmd_ok(args):
    if not isinstance(args, list) or not args or not all(isinstance(a, str) for a in args):
        return False
    c, rest = args[0], args[1:]
    if c == "read":
        return bool(rest) and all(_ID_READ.match(a) for a in rest)
    if c == "done":
        return len(rest) >= 1 and bool(_ID_EX.match(rest[0])) and _safe_text(rest[1:])
    if c == "run":
        return len(rest) == 1 and (bool(_ID_EX.match(rest[0])) or bool(re.fullmatch(r"boss\d", rest[0])))
    if c == "undo":
        return len(rest) <= 1 and all(re.fullmatch(r"[\w.\-]+", a) for a in rest)
    if c == "start":
        return not rest
    if c in ("stop", "log"):
        return _safe_text(rest) and (c == "stop" or bool(rest))
    if c == "boss":
        return len(rest) == 1 and rest[0].isdigit()
    return False


def open_in_editor(path):
    custom = os.environ.get("QUEST_EDITOR")
    if custom:
        cmd = shlex.split(custom) + [str(path)]
    elif shutil.which("code"):
        cmd = ["code", str(path)]
    elif shutil.which("subl"):
        cmd = ["subl", str(path)]
    elif sys.platform == "darwin":
        cmd = ["open", "-t", str(path)]
    else:
        cmd = ["xdg-open", str(path)]
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_world(book, args):
    import http.server
    import secrets
    import threading
    import webbrowser
    port, auto_open = WORLD_PORT, "--no-open" not in args
    if "--port" in args:
        try:
            port = int(args[args.index("--port") + 1])
        except (IndexError, ValueError):
            die("Usage: ./quest world [--port N] [--no-open]")
    if not WORLD_HTML.exists():
        die(f"Missing {rel(WORLD_HTML)}.")
    token = secrets.token_hex(16)
    lock = threading.Lock()
    me = str(Path(__file__).resolve())
    origins = {f"http://127.0.0.1:{port}", f"http://localhost:{port}"}

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def send(self, code, body, ctype="application/json"):
            data = body if isinstance(body, bytes) else json.dumps(body, ensure_ascii=False).encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            path = self.path.split("?")[0]
            if path in ("/", "/index.html"):
                html = WORLD_HTML.read_text(encoding="utf-8").replace("__QUEST_TOKEN__", token)
                return self.send(200, html.encode("utf-8"), "text/html; charset=utf-8")
            if path == "/api/state":
                with lock:
                    return self.send(200, world_state(book))
            return self.send(404, {"error": "not found"})

        def do_POST(self):
            if self.headers.get("X-Quest-Token") != token:
                return self.send(403, {"error": "bad token: reload the page"})
            origin = self.headers.get("Origin")
            if origin and origin not in origins:
                return self.send(403, {"error": "bad origin"})
            try:
                body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
            except ValueError:
                return self.send(400, {"error": "bad json"})
            path = self.path.split("?")[0]
            if path == "/api/cmd":
                a = body.get("args")
                if not world_cmd_ok(a):
                    return self.send(400, {"error": "command not allowed"})
                timeout = 300 if a[0] == "boss" else 120
                env = dict(os.environ, NO_COLOR="1", PYTHONDONTWRITEBYTECODE="1")
                with lock:
                    try:
                        r = subprocess.run([sys.executable, me] + a, cwd=ROOT, env=env, stdin=subprocess.DEVNULL,
                                           capture_output=True, text=True, timeout=timeout)
                        out, code = (r.stdout + r.stderr), r.returncode
                    except subprocess.TimeoutExpired as e:
                        out, code = ((e.stdout or "") if isinstance(e.stdout, str) else "") + "\n(timed out)", 124
                return self.send(200, {"code": code, "output": out})
            if path == "/api/open":
                p = (ROOT / str(body.get("path", ""))).resolve()
                if ROOT not in p.parents or not p.exists():
                    return self.send(400, {"error": "path not in this folder"})
                open_in_editor(p)
                return self.send(200, {"ok": True})
            if path == "/api/pdf":
                key = body.get("key")
                p = book.side_pdf(book.side[key]) if key in book.side else book.pdf()
                if not p:
                    return self.send(404, {"error": "PDF not found"})
                subprocess.Popen(["open" if sys.platform == "darwin" else "xdg-open", str(p)])
                return self.send(200, {"ok": True})
            if path == "/api/tick":
                b = book.bosses.get(body.get("n"))
                if not b or not isinstance(body.get("i"), int):
                    return self.send(400, {"error": "bad boss"})
                with lock:
                    ok = boss_tick(b, body["i"], bool(body.get("on")))
                return self.send(200, {"ok": ok})
            return self.send(404, {"error": "not found"})

    try:
        srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    except OSError:
        die(f"Port {port} is busy. Is the world already open? Try ./quest world --port {port + 1}")
    url = f"http://127.0.0.1:{port}/"
    print(f"\n  🗺️  {B('The world is open')} at {CYN(url)}")
    print(DIM("  Drag or two-finger swipe to pan · scroll/pinch to zoom · click anything."))
    print(DIM("  Keep this terminal open while you play; Ctrl-C closes the world.\n"))
    if auto_open:
        webbrowser.open(url)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\n  👋 World closed. Your progress is saved.")
    finally:
        srv.server_close()

HELP = f"""
  {B('quest')}: your C++ Crash Course progress, as a game

  {B('Daily loop')}
    ./quest                      dashboard: level, streak, today's goal, next steps
    ./quest start                start a focus timer (+1 XP/min, {SESSION_MIN}–{SESSION_CAP_XP})
    ./quest read [2.3 | 2 | 2.all]  mark reading done (no arg = the next one)
    ./quest run 2-1 [--asan] [-- args]   compile + run an exercise (or bossN, or any .cpp path)
    ./quest done 2-1 ["note"]    compile-check and claim an exercise (0 warnings = +{XP_CLEAN} bonus)
    ./quest stop ["note"]        end the timer; writes a session summary to journal.md
    ./quest review [n] [ch3]     flashcards from your notes.md files

  {B('Look around')}
    ./quest world                the clickable world map in your browser (pan, zoom, click to act)
    ./quest map                  every chapter + boss
    ./quest ch [n]               one chapter: reading quests, exercises, files
    ./quest boss [n]             list bosses / fight one
    ./quest badges · stats       achievements · XP breakdown + 12-week heatmap
    ./quest pdf                  open the book

  {B('Side quests')}  (optional books: XP + streak days, never required)
    ./quest side [key]           list side books / one book's quests and labs
