def load_cards(book, only=None):
    cards = []
    units = [(c["num"], c) for c in book.chapters] + [(s["key"], s) for s in book.side.values()]
    for tag, c in units:
        if only is not None and tag != only:
            continue
        p = ROOT / c["dir"] / "notes.md"
        if not p.exists():
            continue
        lines = p.read_text(encoding="utf-8", errors="replace").splitlines()
        i = 0
        while i < len(lines):
            m = re.match(r"^\s*Q:\s*(.*\S)\s*$", lines[i])
            if not m:
                i += 1
                continue
            q, ans, j = m.group(1), [], i + 1
            while j < len(lines):
                ln = lines[j]
                if re.match(r"^\s*Q:", ln) or ln.startswith("#"):
                    break
                ma = re.match(r"^\s*A:\s*(.*)$", ln)
                if not ans and ma:
                    ans.append(ma.group(1))
                elif ans and ln.strip():
                    ans.append(ln)
                elif ans and not ln.strip():
                    break
                j += 1
            a = "\n".join(ans).strip()
            if a:
                cards.append({"id": hashlib.sha1(q.encode()).hexdigest()[:10], "q": q, "a": a, "ch": tag})
            i = j
    return cards


def cmd_review(book, args):
    n, only = 5, None
    for a in args:
        if a.startswith("ch") and a[2:].isdigit():
            only = int(a[2:])
        elif a in book.side:
            only = a
        elif a.isdigit():
            n = int(a)
    cards = load_cards(book, only)
    if not cards:
        die("No flashcards yet. Add them under '## 🃏 Flashcards' in any chapter's notes.md:\n"
            "    Q: What does RAII stand for?\n    A: Resource Acquisition Is Initialization")
    save = load_save()
    stats = save["cards"]
    today = now().date()

    def weight(cd):
        s = stats.get(cd["id"])
        if not s:
            return 3.0
        age = (today - date.fromisoformat(s["last"])).days
        return max(0.3, 1 + 2 * s["miss"] - 0.5 * s["ok"]) + age / 7

    pool, picks = cards[:], []
    while pool and len(picks) < n:
        cd = random.choices(pool, weights=[weight(x) for x in pool])[0]
        picks.append(cd)
        pool.remove(cd)
    print(f"\n  ♻️  Flashcard review: {len(picks)} of {len(cards)} cards. Answer in your head, then reveal.\n")
    ok = seen = 0
    results = {}
    try:
        for idx, cd in enumerate(picks, 1):
            tag = f"ch {cd['ch']}" if isinstance(cd["ch"], int) else cd["ch"]
            print(f"  {CYN('Q' + str(idx))} {DIM('[' + tag + ']')} {B(cd['q'])}")
            input(DIM("     ↵ reveal "))
            print(textwrap.indent(cd["a"], "     " + GRN("A ")))
            got = input("     got it? [y/n] ").strip().lower().startswith("y")
            results[cd["id"]] = got
            seen += 1
            ok += got
            print()
    except (EOFError, KeyboardInterrupt):
        print(DIM("\n  (review stopped early)"))
    if not seen:
        return

    def fn(save):
        for cid, got in results.items():
            s = save["cards"].setdefault(cid, {"ok": 0, "miss": 0, "last": today.isoformat()})
            s["ok" if got else "miss"] += 1
            s["last"] = today.isoformat()
        save["events"].append({"t": "review", "n": seen, "ok": ok, "at": iso(now())})
    _, k = mutate(book, fn)
    print(f"  {ok}/{seen} correct  {YEL('+' + str(min(REVIEW_CAP, REVIEW_XP * ok)) + ' XP')} {DIM('(max ' + str(REVIEW_CAP) + ' XP/day from reviews)')}")
    mini(k)


