PREFIXES = [Path("/opt/homebrew"), Path("/usr/local")]


def boost_available():
    return any((p / "include" / "boost").is_dir() for p in PREFIXES)


def build(sources, out_name, sanitize=None):
    cxx = os.environ.get("CXX", "clang++")
    if not shutil.which(cxx):
        die(f"Compiler '{cxx}' not found. Install the Xcode command-line tools: xcode-select --install")
    BUILD.mkdir(exist_ok=True)
    out = BUILD / out_name
    cmd = [cxx, "-std=c++20", "-Wall", "-Wextra", "-g"]
    for p in PREFIXES:
        if (p / "include").is_dir():
            cmd += ["-isystem", str(p / "include")]
        if (p / "lib").is_dir():
            cmd += ["-L", str(p / "lib")]
    if sanitize == "asan":
        cmd += ["-fsanitize=address,undefined", "-fno-omit-frame-pointer"]
    elif sanitize == "tsan":
        cmd += ["-fsanitize=thread"]
    extra = []
    for s in sources:
        for m in re.finditer(r"//\s*quest-flags:\s*(.+)$", s.read_text(encoding="utf-8", errors="replace"), re.M):
            extra += shlex.split(m.group(1))
    srcs = [rel(s) for s in sources]           # relative paths → short, clickable diagnostics
    cmd += srcs + extra + ["-o", rel(out)]
    short = [cxx, "-std=c++20", "-Wall", "-Wextra", "-g"] + \
            (["-fsanitize=" + ("address,undefined" if sanitize == "asan" else "thread")] if sanitize else []) + \
            srcs + extra + ["-o", rel(out)]
    print(DIM("  $ " + " ".join(shlex.quote(x) for x in (cmd if os.environ.get("QUEST_VERBOSE") else short))))
    sys.stdout.flush()
    p = subprocess.run(cmd, capture_output=True, text=True, cwd=ROOT)
    text = (p.stdout + p.stderr).rstrip()
    warnings = len(re.findall(r"\bwarning:", text))
    if text:
        print(textwrap.indent(text, "  "))
    if p.returncode != 0 and "boost/" in text and not boost_available():
        print(YEL("  Boost isn't installed. Run: brew install boost"))
    return p.returncode == 0, warnings, out


def sources_in(path):
    if path.is_dir():
        return sorted(f for f in path.rglob("*.cpp") if "tests" not in f.relative_to(path).parts)
    return [path] if path.exists() else []


def resolve_target(book, target):
    """→ (label, sources, out_name). target: exercise id, bossN, or a path to a .cpp/folder."""
    if target in book.ex:
        c, e = book.ex[target]
        if not e["file"]:
            die(f"{target} is a {e['kind']} task, not code. Mark it with: ./quest done {target}")
        p = book.ex_path(c, e)
        return f"exercise {target}", sources_in(p), p.stem if p.is_file() else p.name
    m = re.fullmatch(r"(?:boss|b)(\d+)", target)
    if m and int(m.group(1)) in book.bosses:
        b = book.bosses[int(m.group(1))]
        return f"boss {b['n']}", sources_in(book.boss_dir(b)), b["dir"]
    for base in (Path.cwd(), ROOT):
        p = (base / target)
        if p.exists():
            return rel(p), sources_in(p), p.stem if p.is_file() else p.name
    die(f"Don't know '{target}'. Use an exercise id (2-1), boss3, or a path to a .cpp file / folder.")


