COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ


def _c(code):
    return (lambda s: f"\033[{code}m{s}\033[0m") if COLOR else (lambda s: str(s))


B, DIM, RED, GRN, YEL, BLU, MAG, CYN = (_c(x) for x in ("1", "2", "31", "32", "33", "34", "35", "36"))


def bar(frac, width=20):
    frac = max(0.0, min(1.0, frac))
    n = int(round(frac * width))
    return "█" * n + "░" * (width - n)


def spark(values):
    ticks = "▁▂▃▄▅▆▇█"
    top = max(values) if values and max(values) > 0 else 1
    return "".join("·" if v <= 0 else ticks[min(7, int(v / top * 7.999))] for v in values)


def fmt(n):
    return f"{n:,}"


def die(msg, code=1):
    print(RED("✗ ") + msg)
    sys.exit(code)


def rel(p):
    try:
        return str(Path(p).resolve().relative_to(ROOT))
    except ValueError:
        return str(p)


def wrap(text, indent, width=78):
    return textwrap.fill(text, width=width, initial_indent=indent, subsequent_indent=indent)


def now():
    fake = os.environ.get("QUEST_NOW")  # handy for testing streaks
    return datetime.fromisoformat(fake) if fake else datetime.now().replace(microsecond=0)


def iso(d):
    return d.isoformat(timespec="seconds")


def stars(n):
    return "★" * n + " " * (3 - n)


def hm(minutes):
    h, m = divmod(int(minutes), 60)
    return f"{h}h {m:02d}m" if h else f"{m}m"


def threshold(level):
    k = level - 1
    return 60 * k * k + 180 * k   # Lv 20 ≈ 25k XP ≈ the whole book plus steady habits


def level_for(xp):
    lv = 1
    while threshold(lv + 1) <= xp:
        lv += 1
    return lv


def title_for(lv):
    return TITLES[lv - 1] if lv <= len(TITLES) else f"Legend ★{lv - len(TITLES)}"


# ───────────────────────────── book + save ─────────────────────────────
class Book:
    def __init__(self):
        if not BOOK_FILE.exists():
            die(f"Missing {rel(BOOK_FILE)} — this folder's level data is gone.")
        d = json.loads(BOOK_FILE.read_text(encoding="utf-8"))
        self.title = d["title"]
        self.companion = d.get("companion_code", "")
        self.chapters = d["chapters"]
        self.ch = {c["num"]: c for c in self.chapters}
        self.bosses = {b["n"]: b for b in d["bosses"]}
        self.reading, self.ex = {}, {}
        for c in self.chapters:
            for q in c["reading"]:
                self.reading[q["id"]] = (c, q)
            for e in c["exercises"]:
                self.ex[e["id"]] = (c, e)
        self.side = {s["key"]: s for s in d.get("side", [])}
        for s in self.side.values():
            for sc in s["chapters"]:
                for q in sc["reading"]:
                    self.reading[q["id"]] = (s, q)
            for lab in s["labs"]:
                self.ex[lab["id"]] = (s, lab)

    def ex_path(self, c, e):
        return ROOT / c["dir"] / "exercises" / e["file"].rstrip("/")

    @staticmethod
    def is_dir(e):
        return e["file"].endswith("/")

    @staticmethod
    def ex_xp(e):
        return XP_STARS[e["stars"]] if e["kind"] in ("code", "lab") else XP_NONCODE

    @staticmethod
    def required_ex(c):
        return [e for e in c["exercises"] if not e["optional"]]

    def boss_dir(self, b):
        return PROJECTS / b["dir"]

    def pdf(self):
        pdfs = sorted(ROOT.glob("*.pdf"))
        named = [p for p in pdfs if "crash course" in p.name.lower()]
        return (named or pdfs or [None])[0]

    def side_pdf(self, s):
        hits = sorted(p for p in ROOT.rglob("*.pdf") if s["pdf_match"] in p.name.lower())
        return hits[0] if hits else None


def pages_of(q):
    return f"p.{q['page']}–{q.get('page_end', q['end'])}"


def is_side_id(i):
    return not i.split(".")[0].split("-")[0].isdigit()


def load_save():
    s = json.loads(SAVE_FILE.read_text(encoding="utf-8")) if SAVE_FILE.exists() else {}
    s.setdefault("version", 1)
    s.setdefault("created", iso(now()))
    s.setdefault("settings", {}).setdefault("daily_goal", DEFAULT_GOAL)
    s.setdefault("events", [])
    s.setdefault("session", None)
    s.setdefault("cards", {})
    s.setdefault("badge_dates", {})
    return s


def write_save(s):
    QDIR.mkdir(exist_ok=True)
    tmp = SAVE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(s, indent=1, ensure_ascii=False) + "\n", encoding="utf-8")
    tmp.replace(SAVE_FILE)


