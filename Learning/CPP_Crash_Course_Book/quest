def journal_append(lines):
    t = now()
    text = JOURNAL.read_text(encoding="utf-8") if JOURNAL.exists() else JOURNAL_TEMPLATE
    head = f"## {t:%Y-%m-%d} · {t:%A}"
    heads = re.findall(r"^## \d{4}-\d{2}-\d{2}.*$", text, re.M)
    if not text.endswith("\n"):
        text += "\n"
    if not heads or heads[-1].strip() != head:
        text += f"\n{head}\n\n"
        while lines and lines[0] == "":
            lines = lines[1:]
    text += "\n".join(lines) + "\n"
    JOURNAL.write_text(text, encoding="utf-8")


def heatmap(k, weeks=12):
    today = now().date()
    start = today - timedelta(days=today.weekday() + 7 * (weeks - 1))
    rows = []
    for wd, name in enumerate(["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]):
        cells = []
        for w in range(weeks):
            d = start + timedelta(days=7 * w + wd)
            if d > today:
                cells.append(" ")
                continue
            x = k.action_xp.get(d.isoformat(), 0)
            cells.append("·" if x == 0 else "░" if x < k.goal / 2 else "▒" if x < k.goal else "▓" if x < 2 * k.goal else "█")
        rows.append(f"{name} " + " ".join(cells))
    return rows


