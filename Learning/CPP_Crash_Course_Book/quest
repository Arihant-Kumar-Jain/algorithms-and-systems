            "cleared": v.cleared_at if v.cleared else None, "started": v.started,
            "reading": [rq(q) for q in c["reading"]], "exercises": [ex(c, e) for e in c["exercises"]]})
    bosses = []
    for b in book.bosses.values():
        bosses.append({"n": b["n"], "name": b["name"], "pitch": b["pitch"], "xp": b["xp"], "unlock": b["unlock"],
                       "unlocked": boss_unlocked(k, b), "defeated": k.boss.get(b["n"]), "goals": boss_goals(b),
                       "readme": rel(book_boss_readme(b)), "main": rel(book.boss_dir(b) / "main.cpp"), "build": b["build"]})
    side = []
    for s in book.side.values():
        v = k.side[s["key"]]
