STUB_HASHES = QDIR / "stubs.json"


def sha(data):
    return hashlib.sha1(data).hexdigest()


def load_stub_hashes():
    return json.loads(STUB_HASHES.read_text()) if STUB_HASHES.exists() else {}


def untouched(book, path):
    """True if the file/folder still holds exactly what `quest init` generated (by recorded hash or template)."""
    rec, st = load_stub_hashes(), stubs(book)

    def same(f):
        data = f.read_bytes()
        if not data.strip():
            return True
        return rec.get(rel(f)) == sha(data) or st.get(f, "").encode("utf-8") == data

    if path.is_dir():
        files = [f for f in path.rglob("*") if f.is_file() and f.name != ".DS_Store"]
        return all(same(f) for f in files)
    return path.exists() and same(path)


def unit_name(book, ch):
    if isinstance(ch, int):
        return f"chapter {ch}"
    return book.side[ch]["short"] if ch in book.side else str(ch)


def notes_lines(book, c):
    p = ROOT / c["dir"] / "notes.md"
    if not p.exists():
        return 0
    tmpl = {ln.strip() for ln in (side_notes_template(c) if "key" in c else notes_template(c)).splitlines()}
    n = 0
    for ln in p.read_text(encoding="utf-8", errors="replace").splitlines():
        s = ln.strip()
        if s and s not in tmpl and s not in ("-", "Q:", "A:") and not s.startswith("<!--"):
            n += 1
    return n


def add_scribe_events(book, save):
    have = {e["ch"] for e in save["events"] if e["t"] == "scribe"}
    for c in book.chapters:
        if c["num"] not in have and notes_lines(book, c) >= SCRIBE_LINES:
            save["events"].append({"t": "scribe", "ch": c["num"], "at": iso(now())})
    for s in book.side.values():
        if s["key"] not in have and notes_lines(book, s) >= SCRIBE_LINES:
            save["events"].append({"t": "scribe", "ch": s["key"], "at": iso(now())})


