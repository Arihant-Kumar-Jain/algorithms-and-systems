        return {"id": q["id"], "title": q["title"], "pages": pages_of(q), "page": q["page"], "xp": q["xp"],
                "optional": bool(q.get("optional")), "done": k.read.get(q["id"])}

    def ex(c, e):
        d = k.exd.get(e["id"])
        return {"id": e["id"], "kind": e["kind"], "stars": e["stars"], "title": e["title"], "task": e["task"],
                "path": rel(book.ex_path(c, e)) if e.get("file") else None, "optional": e["optional"],
                "bonus": e["bonus"], "boost": e["boost"], "xp": Book.ex_xp(e),
                "done": d["at"] if d else None, "clean": bool(d and d.get("clean"))}

    chapters = []
